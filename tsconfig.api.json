{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": ["api", "tests", "src/protocol", "src/lab/genome.ts", "src/lab/morphology.ts", "src/lab/dnaGlyph.ts", "src/lib/random.ts", "src/lib/solana/tx.ts"]
}
