# Quantum Fork configuration.
#
# Two sets of keys, read by two different programs:
#   VITE_*  are compiled into the browser bundle. They are public. Never put a secret here.
#   others  are read by the Vercel functions in /api at request time. They never reach the bundle.
# The server is authoritative: the browser asks /api/status what is actually enabled.
#
# Every dangerous switch defaults to false. Deploying to Vercel does not turn anything on.

# ---------- browser (public) ----------

VITE_SOLANA_NETWORK=devnet                 # devnet | testnet | mainnet-beta
VITE_SOLANA_RPC_URL=                       # blank = public endpoint for the network; must be https
VITE_QFORK_MINT=                           # the ONE place the mint is set; blank until launch
VITE_TOKEN_STATUS=PRELAUNCH                # PRELAUNCH | LIVE (LIVE requires a valid mint)
VITE_PUMPFUN_URL=                          # optional https://pump.fun/... link; derived from the mint on mainnet
VITE_SITE_URL=https://quantumfork.wtf

VITE_ENABLE_SCANNER=true
VITE_ENABLE_REAL_BURNS=false
VITE_ENABLE_TESTNET_DEPLOYMENTS=false
VITE_ENABLE_MAINNET_DEPLOYMENTS=false      # mainnet registration; needs mainnet-beta, TOKEN_STATUS=LIVE and the live mint
VITE_ENABLE_PUMPFUN_DATA=false             # mainnet only
VITE_ENABLE_EXPERIMENTAL_PQ=false
VITE_ENABLE_PUMPFUN_LAUNCH=false           # descendant owners may create Pump.fun tokens (real SOL, mainnet)

# ---------- server (secret or authoritative) ----------

SOLANA_NETWORK=devnet
SOLANA_RPC_URL=                            # use a dedicated provider in production; may contain an API key
QFORK_MINT=
TOKEN_STATUS=PRELAUNCH
PUMPFUN_URL=
SITE_URL=https://quantumfork.wtf

ENABLE_SCANNER=true
ENABLE_REAL_BURNS=false
ENABLE_TESTNET_DEPLOYMENTS=false
ENABLE_MAINNET_DEPLOYMENTS=false
ENABLE_PUMPFUN_DATA=false
ENABLE_EXPERIMENTAL_PQ=false
ENABLE_PUMPFUN_LAUNCH=false

# Mainnet RPC for Pump.fun launches (relay and verification). Blank = public mainnet endpoint.
MAINNET_RPC_URL=

# Devnet faucet: the test mint's authority as a 64-byte JSON array (solana-keygen format).
# Secret. Server only, never VITE_. Ignored on mainnet. Blank = no faucet.
QFORK_FAUCET_KEYPAIR=

# Upstash Redis (Vercel KV). Without it the server uses memory and refuses burns, launches
# and the faucet, because a record that can vanish on a cold start cannot prevent double-crediting.
KV_REST_API_URL=
KV_REST_API_TOKEN=

ALLOWED_ORIGINS=                           # extra comma-separated origins allowed to POST; SITE_URL is always allowed
LOG_LEVEL=info                             # debug | info | warn | error

# ---------- Base (server-only; the client reads these through /api/status) ----------
BASE_NETWORK=base-sepolia                  # base-sepolia | base
BASE_RPC_URL=                              # https only; blank = public endpoint. http://127.0.0.1:<port> is accepted in local dev only (Anvil)
QFORK_BASE_TOKEN=                          # $QFORK ERC-20 on Base; blank until launch
BASE_TOKEN_STATUS=PRELAUNCH                # PRELAUNCH | LIVE (LIVE requires QFORK_BASE_TOKEN)
ENABLE_BASE_DEPLOYMENTS=false              # registration burns on Base; mainnet also needs BASE_TOKEN_STATUS=LIVE
ENABLE_CLANKER_LAUNCH=false                # descendant owners may launch Clanker v4 tokens from their own wallet
QFORK_REGISTRY_ADDRESS=                    # QForkRegistry on BASE_NETWORK (contracts/); blank = anchoring off
